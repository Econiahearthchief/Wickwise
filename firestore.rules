rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Recipes — only the owner can create, read, update, or delete their own
    match /recipes/{recipeId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Gallery submissions — anyone can submit (must start as "pending"),
    // public can only read "approved" ones, only the admin can approve/edit
    match /gallery_submissions/{subId} {
      allow create: if request.resource.data.status == 'pending';
      allow read: if resource.data.status == 'approved';
      allow update, delete: if request.auth != null
                    && request.auth.token.email == 'chief.econia@gmail.com';
    }

    // Verified sellers — public can read the directory, only admin can add/edit
    match /verified_sellers/{sellerId} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.email == 'chief.econia@gmail.com';
    }
  }
}
