# ---------------------------------------------------------------------------
# LaunchForward Receptionist — environment template
# Copy to .env and fill in. PLACEHOLDER VALUES ONLY — never commit a real .env.
# ---------------------------------------------------------------------------

# Twilio (from twilio.com/console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# Public base URL of this server, e.g. https://your-api.onrender.com
# Twilio will call ${TWILIO_WEBHOOK_URL}/voice for incoming calls.
TWILIO_WEBHOOK_URL=https://your-api.onrender.com

# Firebase Admin SDK (from Firebase console → Project settings → Service accounts)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Paste the private key as ONE line with literal \n between the header/footer
# and the key body. Example: -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_BODY\n-----END PRIVATE KEY-----\n

# Stripe (from dashboard.stripe.com/developers/api-keys)
# Secret key (test mode while developing: sk_test_...; live later: sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret for the stripe-webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Simple shared secret protecting any future admin endpoints (pick a long random string)
ADMIN_API_KEY=change-me-to-a-long-random-string
